# Copy this file to .env and fill in local secrets.

APP_ENV=development
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false

WEBULL_ENV=sandbox
WEBULL_REGION=us
WEBULL_API_HOST=api.sandbox.webull.com
WEBULL_TRADE_EVENTS_HOST=events-api.sandbox.webull.com
WEBULL_DATA_STREAM_HOST=data-api.sandbox.webull.com
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_SANDBOX_APP_KEY=
WEBULL_SANDBOX_APP_SECRET=
WEBULL_ACCESS_TOKEN=
WEBULL_ACCOUNT_ID=
WEBULL_SANDBOX_ACCOUNT_ID_INV_CASH=
WEBULL_SANDBOX_ACCOUNT_ID_INV_MARGIN=
WEBULL_ALLOWED_PRODUCTS=stocks,etfs
MARKET_DATA_POLICY=free
WEBULL_PAPER_SYMBOLS=AAPL,SPY
WEBULL_PAPER_FALLBACK_SYMBOLS=AAPL
WEBULL_PAPER_POLL_SECONDS=60
WEBULL_PAPER_TRADE_SIZE=1
WEBULL_PAPER_DATA_SOURCE=public_yahoo
WEBULL_PAPER_ORDER_ROUTING=sandbox
# Shared across Cash and Margin workers; prevents API bursts and 429 retries.
WEBULL_ORDER_MIN_INTERVAL_SECONDS=10
WEBULL_ORDER_MAX_PER_MINUTE=6
WEBULL_ORDER_429_COOLDOWN_SECONDS=120
PAPER_STRATEGY=moving_average
SHADOW_PORTFOLIO=warren_buffett
PAPER_HISTORY_DB_PATH=.data/paper_history.sqlite3
PAPER_TRADING_KILL_SWITCH=false
PAPER_MANUAL_APPROVAL_REQUIRED=false
MAX_DAILY_ORDER_COUNT=10
MAX_RISK_VIOLATIONS=0
LIVE_TRADING_OPERATOR_OVERRIDE=false

MAX_DAILY_LOSS_PCT=0.03
MAX_POSITION_PCT=0.25
MAX_ORDER_NOTIONAL_PCT=0.10
