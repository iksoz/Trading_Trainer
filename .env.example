# Copy this file to .env and fill in local secrets.

APP_ENV=development
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false

WEBULL_ENV=production
WEBULL_REGION=us
WEBULL_API_HOST=api.webull.com
WEBULL_TRADE_EVENTS_HOST=events-api.webull.com
WEBULL_DATA_STREAM_HOST=data-api.webull.com
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCESS_TOKEN=
WEBULL_ACCOUNT_ID=
WEBULL_ALLOWED_PRODUCTS=stocks,etfs
MARKET_DATA_POLICY=free
LIVE_TRADING_OPERATOR_OVERRIDE=false

MAX_DAILY_LOSS_PCT=0.03
MAX_POSITION_PCT=0.25
MAX_ORDER_NOTIONAL_PCT=0.10
